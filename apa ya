        <!-- Royalty-free wedding melody background -->
        <source src="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3?filename=romantic-piano-112199.mp3" type="audio/mpeg">
    </audio>

    <!-- FLOATING MUSIC CONTROLLER -->
