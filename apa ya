            </div>

            <button onclick="openInvitation()" class="group relative inline-flex items-center gap-3 px-8 py-4 bg-white text-black font-semibold uppercase tracking-widest text-xs rounded-full overflow-hidden transition-all duration-300 hover:bg-gray-200 hover:shadow-[0_0_20px_rgba(255,255,255,0.4)] active:scale-95">
