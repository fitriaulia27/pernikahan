                    <span class="text-[10px] uppercase tracking-widest text-gray-400 font-semibold">Jam</span>
                </div>
                <div class="p-6 border border-white/10 rounded-xl bg-luxury-black flex flex-col items-center">
                    <span id="minutes" class="font-display text-4xl md:text-5xl font-bold mb-2">00</span>
